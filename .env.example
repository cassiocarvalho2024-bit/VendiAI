# Flask
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///vendiAI.db

# OpenAI API
OPENAI_API_KEY=seu-api-key-openai-aqui

# Stripe (para pagamentos - adicionar depois)
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_aqui

# MercadoPago (alternativa ao Stripe)
MERCADOPAGO_ACCESS_TOKEN=seu-token-aqui

# Email (para notificações)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app-aqui
